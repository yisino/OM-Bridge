# =============================================================================
# OM-Bridge 配置文件模板（带逐项说明）
# =============================================================================
#
# 怎么用
# ------
#   1) 拷贝一份： cp config/om-bridge.env.example config/om-bridge.env
#      （或者放到工作区根目录，名字就叫 .env —— 优先级更高，见下面的查找顺序）
#   2) 从上到下**人工过一遍**。带「⚠ 通常需要改」标记的项是少数；
#      其余项的默认值就是推荐值，看懂注释后可以原样保留。
#   3) 改完自查（不用猜，程序会告诉你每一项的取值与来源）：
#        om-bridge config report                        # 全部取值 + 来源 + 越界枚举
#        om-bridge config list                          # 表格形式
#        om-bridge config explain backend.comfyui.server_url
#
# 配置文件查找顺序（取**第一个存在**的，不合并多个）：
#
#   1. 环境变量 OMB_ENV_FILE 指定的路径
#   2. <工作区>/.env
#   3. <工作区>/config/om-bridge.env      <- 本模板的位置
#   4. ~/.config/om-bridge/om-bridge.env
#
# 「不合并」是有意的：合并多层会让"这个值到底哪来的"变成玄学。
# 想临时覆盖某一项时，用进程环境变量那一层（优先级高于配置文件）：
#   OMB_COMFY_SERVER_URL=http://... om-bridge doctor
#
# 优先级（从高到低）：
#   显式覆盖(API/CLI) > 进程环境变量 > 配置文件 > 内置默认值
#
# ⚠ 关于变量命名（2026-09 配置整顿）
# --------------------------------
# 所有配置项统一使用 **OMB_ 短前缀**（见 ADR-0009）：
#   * 环境变量是进程级公共地盘，裸名（TIMEOUT/STRICT/ENV_FILE 等）极易与
#     其他工具撞名；OMB_ 既短又能隔出命名空间。
#   * 更早版本的 OM_BRIDGE_* 与 COMFYUI_*（含别名兼容层）已全部移除，
#     旧名**不再被读取**。遗留旧变量会在
#     `om-bridge config report --include-unknown-env` 里被点名，顺手清掉即可。
#
# ⚠ 密钥不要提交
# --------------
# 本文件是 `*.env.example`，会被 git 跟踪；真正的 `*.env` 已被 .gitignore 排除。
# 涉及 token / 密码的项在 `config report` 里会被打码显示。
# =============================================================================


# =============================================================================
# 一、全局（与具体后端无关）
# =============================================================================

# 未显式指定后端时使用哪个后端。
# 枚举值（内置）：
#   comfyui -> 本地/局域网 ComfyUI 实例（默认）
#   mock    -> 离线参考实现，产物为作业转写 JSON，零网络依赖，用于测试
# 第三方插件可通过 entry points 注册更多后端（此时不在上列，属正常）。
# 何时改：只有在多后端部署、想改变默认走向时才需要。
OMB_DEFAULT_BACKEND=comfyui

# 未显式指定方案时使用哪个方案。可以写成带模式的别名（如 minimax_h3.t2v），
# 但不建议 —— 默认值写成"某个具体模式"会让调用方误以为只有那一种形态。
# 枚举值（内置）：
#   minimax_h3      -> MiniMax H3 视频生成（t2v/i2v/flf2v/ref2v 四种模式）
#   echo            -> mock 后端配套的转写方案，单文件最小实现
# 第三方插件可扩展更多方案。
OMB_DEFAULT_SOLUTION=minimax_h3

# ⚠ 通常需要改：工作区根目录。产物、上传缓存、物化后的计算图默认都挂在它下面。
# 相对路径按进程当前目录解析 —— 部署机上务必写绝对路径，
# 否则"从哪个目录启动"会改变落盘位置。
OMB_WORKSPACE=/home/vincent/MY_WS

# 产物默认落盘目录。留空则用 <工作区>/var/output。
# 何时改：想把产物集中到独立大盘时。生产机上建议指向容量充足且**是本地盘**
# 的路径：跨网（NFS/SMB）写大视频会明显拖慢整条流水线。
OMB_OUTPUT_DIR=

# 连接与轻量探测（/system_stats、建连）的超时（秒）。
# 何时改：跨隧道/高延迟链路上可适当调大；同机直连不必动。
OMB_CONNECT_TIMEOUT=15

# 等待一次作业完成的总超时（秒）。默认 900 = 15 分钟。
#
# ⚠ 超时**不等于失败**。作业通常仍在后端继续跑，只是"还没等到结果"。
#   正确做法是用 resume 续等：
#       om-bridge resume --job-id <ID> --timeout 3600
#   重新提交会排入一个重复作业，并与原作业争抢同一块 GPU —— 两件事都变慢。
#   在单卡机上，这个误操作的代价尤其明显。
OMB_TIMEOUT=900

# 轮询间隔（秒）。后端越慢越应该调大，减少无谓的 HTTP 请求。
# 经验值：本地卡 5s；跨网慢链路 10~15s。
# 注意：ComfyUI 后端可以用 backend.comfyui.poll_interval 按后端覆盖这个值。
OMB_POLL_INTERVAL=5

# 提交前是否做静态校验（参数类型/范围/资产就绪度/载荷检查）。
# 建议保持 true：校验是纯本地的零成本操作，能省下一次必然失败的排队。
OMB_VALIDATE=true

# 严格模式：把非阻断的告警也算作失败。
# 何时改：CI / 自动化流水线里想让"告警"直接挡住发布时设 true。
# validate 报告与 generate 放行走的是同一条裁决，不会出现两套标准。
OMB_STRICT=false

# 日志级别。
# 枚举值：
#   DEBUG   -> 提交/轮询/下载的每一步细节，排查问题用
#   INFO    -> 默认。关键进度节点
#   WARNING -> 仅异常与降级提示
#   ERROR   -> 只报错误
# 日志**只写 stderr** —— 这是硬约束，因为 MCP 用 stdout 传 JSON-RPC，
# CLI 也把 stdout 当数据通道，混一行进去就会让宿主报"invalid JSON"。
#
# ⚠ 只认**进程环境变量**：日志必须在读到任何 .env 之前初始化，
#   所以写在 .env 里的同名变量不生效（启动顺序的固有限制，不是疏漏）。
OMB_LOG_LEVEL=INFO

# 显式指定配置文件路径。留空则按上文顺序自动探测。
# 何时改：多环境切换（如 profile 档）或把配置放在约定位置之外时。
OMB_ENV_FILE=


# =============================================================================
# 二、ComfyUI 后端
# =============================================================================

# ⚠ 通常需要改：ComfyUI 基地址 —— 所有能力的公共地址。单机部署只需要设这一个。
#
# 三种常见拓扑，选对应的写法：
#
#   ① ComfyUI 与调用方在同一台机器
#      OMB_COMFY_SERVER_URL=http://127.0.0.1:8188
#
#   ② 同一局域网（ComfyUI 所在主机监听 0.0.0.0）
#      OMB_COMFY_SERVER_URL=http://192.168.3.3:8188
#
#   ③ 跨网段，且 ComfyUI 位于鉴权代理之后
#      用 SSH 反向隧道，让"远端"看到一个本机端口：
#         # 在 ComfyUI 主机上执行（保持这个连接不断）
#         ssh -N -R 8188:127.0.0.1:8188 <user>@<服务器>
#         # 在服务器上执行 OM-Bridge 时
#         OMB_COMFY_SERVER_URL=http://127.0.0.1:8188
#
#      ⚠ 隧道方案优于"暴露到公网 + 加认证头"，因为核心客户端刻意只依赖
#        标准库、不带认证头。隧道把鉴权与加密交给 SSH，两边都不用改代码。
#      也可直接用现成档位：config/profiles/through-tunnel.env
OMB_COMFY_SERVER_URL=http://127.0.0.1:8188

# 按能力分别指定地址。**只在多机部署时才需要**，单机请一律留空（继承上面）。
# 例如：视频跑在本地 20GB 卡上，图像跑在另一台机器上。
# 何时改：不同能力放在不同主机时；能力寻址的顺序是 专用地址 -> server_url。
OMB_COMFY_VIDEO_SERVER_URL=
OMB_COMFY_IMAGE_SERVER_URL=
OMB_COMFY_MUSIC_SERVER_URL=

# /system_stats 等轻量请求的超时（秒）。
# 与全局 connect_timeout 的关系：后端专属值可以针对这台 ComfyUI 单独放宽。
OMB_COMFY_CONNECT_TIMEOUT=15

# 等待一次渲染完成的总超时（秒）。
OMB_COMFY_READ_TIMEOUT=900

# /history 轮询间隔（秒）。
# 何时改：单进程同时配置多个后端（本地卡慢、云端快）时按后端分别调；
# 留空/置 0 则回落到全局 poll_interval。
OMB_COMFY_POLL_INTERVAL=5

# 拉取 /object_info 的超时（秒）。节点多的实例会明显偏慢（1200+ 个类是常态）。
# 何时改：probe / doctor 反复在 object_info 上超时时调大。
OMB_COMFY_OBJECT_INFO_TIMEOUT=180

# 单次上传媒体的超时（秒）。大参考图 + 慢链路时才需要调大。
OMB_COMFY_UPLOAD_TIMEOUT=300

# 认证。**仅当 ComfyUI 位于鉴权代理之后**才需要；直连本机/局域网请留空。
# api_token 与 auth_user/auth_password 二选一。
# ⚠ 这些是密钥：`config report` 会打码；不要把填了真实值的 .env 提交进 git。
OMB_COMFY_API_TOKEN=
OMB_COMFY_AUTH_USER=
OMB_COMFY_AUTH_PASSWORD=


# =============================================================================
# 三、MiniMax H3 方案
# =============================================================================
# 这一节全是"部署事实"：这台机器上实际装着哪一套权重。
# 它们刻意不是命令行参数 —— 创作参数每次都可能不同，而权重是机器属性。
# 想临时换一套权重做对比，用 `--node-override <节点ID>.<输入名>=值`（逃生舱）。
# 默认值 = 官方 H3 全家桶的标准文件名；换了机器只需核对文件名，无需改语义。

# --- 输出规格 ---
# 宽度 / 高度必须是 32 的倍数。短边推荐 768，上限 768×1344。
# 864×480 是实测的画质/速度平衡点（124 帧 ≈ 100s @ RTX 3080）。
OMB_MINIMAX_H3_WIDTH=864
OMB_MINIMAX_H3_HEIGHT=480

# 帧数（24fps）。会对齐到 **17k+5** 栅格：5, 22, 39, 56, 73, 90, 107, 124, ...
# 124 帧 ≈ 5.2 秒；362 帧 ≈ 15 秒；上限 3600。未对齐时后端会吸附到最近合法值。
OMB_MINIMAX_H3_LENGTH=124

# 封装帧率。H3 原生 24fps，改它只影响容器封装，不影响生成。
OMB_MINIMAX_H3_FPS=24

# 采样步数。0 = 按模式自动（ref2v 用 4，其余用 8）。
#
# ⚠ 步数必须与所选 LoRA **配对**，否则不会报错、只会让画质悄悄变差：
#     turbo 开 + fl2va 权重 -> 8 步
#     turbo 开 + ref2va 权重 -> 4 步
#     不加 LoRA            -> 20 步
# 这种"静默降级"是最难发现的一类问题，因此方案层会对不一致发告警。
OMB_MINIMAX_H3_STEPS=0

# --- 扩散模型 ---
# ⚠ 两套权重**不可互换**：
#   fl2va 系列（下面这个）-> 用于 t2v / i2v / flf2v
#   ref2va 系列（再下面）-> 用于 ref2v
# 混用不会报错，只会得到"能跑但结果不对"的输出。
OMB_MINIMAX_H3_UNET=minimax_h3_fl2va_pruned_int8_convrot.safetensors
OMB_MINIMAX_H3_REF2V_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors

# --- 文本编码器与 VAE（四种形态共用）---
OMB_MINIMAX_H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
OMB_MINIMAX_H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors

# H3 是**音视频联合生成**，缺音频 VAE 就没有音轨（画面正常，静音输出）。
OMB_MINIMAX_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors

# --- Turbo LoRA ---
# 8 步 LoRA 必须配 steps=8；见上文"采样步数"的配对表。
OMB_MINIMAX_H3_TURBO_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
OMB_MINIMAX_H3_REF2V_TURBO_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors

# --- ref2v 专项 ---
# 参考图缩放模式。
# 枚举值：
#   match -> 缩到生成分辨率。快，且是绝大多数场景的正确选择。
#   max   -> 保留 2048px 短边。身份更保真，但参考 token 会贯穿**每一步采样**，
#            慢数倍（ref2v 只有 4 步，所以这个代价是实打实的）。
OMB_MINIMAX_H3_REF2V_IMAGE_SIZE=match

# 默认参考图文件名（是 ComfyUI 主机 input/ 目录里**已有的名字**，不是本地路径）。
# 只在 ref2v 未显式给参考图时生效；调用方显式传的永远优先。
# ⚠ 顺序即语义：第 1 个对应提示词里的 <Picture 1>，第 2 个对应 <Picture 2>……
# 逗号分隔。最多 9 张。
OMB_MINIMAX_H3_REF2V_IMAGES=

# --- 与外部框架的接口 ---
# 用于向外部框架（如 OpenMontage）声明「本机 H3 就绪」的扩散权重要求。
# 由集成层的 publish 脚本读取并写出 COMFYUI_H3_LOCAL_MODELS，供外部框架做前置检查。
# （这个名字是 OpenMontage 实际读取的对外契约，由 publish 层负责写出，
#   与 OM-Bridge 自己的 OMB_ 命名空间无关。）
OMB_MINIMAX_H3_PREFLIGHT_MODELS=minimax_h3_fl2va_pruned_int8_convrot.safetensors,minimax_h3_ref2va_pruned_int8_convrot.safetensors

# 物化后的计算图落盘目录。留空则用 <工作区>/var/graphs。
#
# 为什么需要它：有些外部框架只接受「工作流文件路径 + 输出节点 ID」，
# 拿不到内存里的图。OM-Bridge 的做法是**按需现场物化**：
#     om-bridge graph --solution minimax_h3 --prompt "..." -o <这个目录>/h3_t2v_api.json
# 于是不会再出现"预存的图与代码脱节"。
#
# ⚠ 历史说明：旧配置里的 COMFYUI_MINIMAX_H3_WORKFLOW_PATH / _OUTPUT_NODE /
#    _REF2V_WORKFLOW_PATH / _REF2V_OUTPUT_NODE 四个变量**已不再读取** ——
#    它们存在的唯一理由就是上面这件事，现在由本目录 + 现场物化取代。
OMB_MINIMAX_H3_GRAPH_DIR=
