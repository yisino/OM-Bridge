# =============================================================================
# OM-Bridge 配置文件示例
# =============================================================================
#
# 用法
# ----
#   cp config/om-bridge.env.example config/om-bridge.env
#   # 或者放到工作区根目录，名字就叫 .env（优先级更高）
#
# 配置文件查找顺序（取**第一个存在**的，不合并多个）：
#
#   1. 环境变量 OM_BRIDGE_ENV_FILE 指定的路径
#   2. <工作区>/.env
#   3. <工作区>/config/om-bridge.env      <- 本文件的位置
#   4. ~/.config/om-bridge/om-bridge.env
#
# 优先级（从高到低）：显式覆盖(API) > 进程环境变量 > 配置文件 > 内置默认值
# 同一层内，规范名（OM_BRIDGE_*）优先于旧名（COMFYUI_*）。
#
# 自查
# ----
#   om-bridge config report      # 全部取值 + 来源
#   om-bridge config list        # 表格形式
#   om-bridge config explain backend.comfyui.server_url
#
# ⚠ 旧变量名（COMFYUI_*）永远有效
# --------------------------------
# 现网 SER 上的 comfyui.env 与 OpenMontage/.env 用的都是旧名。OM-Bridge
# 把它们登记为**别名**，与规范名等价读取。因此：
#   * 迁移期间两种名字可以混用；
#   * 不需要为了用 OM-Bridge 去改 OpenMontage 的 .env；
#   * 若同一层里两个名字都设了且值不同，`config report` 会报一条冲突提示。
# 每个变量下方注释里的「旧名:」即为兼容名。
#
# ⚠ 密钥不要提交
# ----------------
# 本文件是 `*.env.example`，会被 git 跟踪；真正的 `*.env` 已被 .gitignore 排除。
# =============================================================================


# =============================================================================
# 一、全局
# =============================================================================

# 未显式指定后端时使用哪个后端。
OM_BRIDGE_DEFAULT_BACKEND=comfyui

# 未显式指定方案时使用哪个方案。可以写成带模式的别名（如 minimax_h3.t2v），
# 但不建议 —— 默认值写成"某个具体模式"会让调用方误以为只有那一种形态。
OM_BRIDGE_DEFAULT_SOLUTION=minimax_h3

# 工作区根目录。产物、上传缓存、物化后的计算图默认都挂在它下面。
# 相对路径按进程当前目录解析。部署时建议写绝对路径。
OM_BRIDGE_WORKSPACE=/home/vincent/MY_WS

# 产物默认落盘目录。留空则用 <工作区>/var/output。
# 生产机上建议指向容量充足且**是本地盘**的路径：
# 跨网（NFS/SMB）写大视频会明显拖慢整条流水线。
OM_BRIDGE_OUTPUT_DIR=

# 连接与轻量探测的超时（秒）。
OM_BRIDGE_CONNECT_TIMEOUT=15

# 等待一次作业完成的总超时（秒）。
#
# ⚠ 超时**不等于失败**。作业通常仍在后端继续跑，只是"还没等到结果"。
#   正确做法是用 resume 续等：
#       om-bridge resume --job-id <ID> --timeout 3600
#   重新提交会排入一个重复作业，并与原作业争抢同一块 GPU —— 两件事都变慢。
#   在单卡机上，这个误操作的代价尤其明显。
OM_BRIDGE_TIMEOUT=900

# 轮询间隔（秒）。后端越慢越应该调大，减少无谓的 HTTP 请求。
OM_BRIDGE_POLL_INTERVAL=5

# 提交前是否做静态校验。
# 建议保持 true：校验是纯本地的零成本操作，能省下一次必然失败的排队。
OM_BRIDGE_VALIDATE=true

# 严格模式：把非阻断的告警也算作失败（CI 场景有用）。
OM_BRIDGE_STRICT=false

# 日志级别：DEBUG / INFO / WARNING / ERROR。
# 日志**只写 stderr** —— 这是硬约束，因为 MCP 用 stdout 传 JSON-RPC，
# CLI 也把 stdout 当数据通道。混一行进去就会让宿主报"invalid JSON"。
OM_BRIDGE_LOG_LEVEL=INFO

# 显式指定配置文件路径。留空则按上文顺序自动探测。
OM_BRIDGE_ENV_FILE=


# =============================================================================
# 二、ComfyUI 后端
# =============================================================================

# ComfyUI 基地址 —— 所有能力的公共地址。单机部署只需要设这一个。
#
# 旧名: COMFYUI_SERVER_URL
#
# 三种常见拓扑，选对应的写法：
#
#   ① ComfyUI 与调用方在同一台机器
#      OM_BRIDGE_COMFYUI_SERVER_URL=http://127.0.0.1:8188
#
#   ② 同一局域网（ComfyUI 所在主机监听 0.0.0.0）
#      OM_BRIDGE_COMFYUI_SERVER_URL=http://192.168.3.3:8188
#
#   ③ 跨网段，且 ComfyUI 位于鉴权代理之后
#      用 SSH 反向隧道，让"远端"看到一个本机端口：
#         # 在 ComfyUI 主机上执行（保持这个连接不断）
#         ssh -N -R 8188:127.0.0.1:8188 vincent@<服务器>
#         # 在服务器上执行 OM-Bridge 时
#         OM_BRIDGE_COMFYUI_SERVER_URL=http://127.0.0.1:8188
#
#      ⚠ 隧道方案优于"暴露到公网 + 加认证头"，因为核心客户端刻意只依赖
#        标准库、不带认证头。隧道把鉴权与加密交给 SSH，两边都不用改代码。
OM_BRIDGE_COMFYUI_SERVER_URL=http://127.0.0.1:8188
# COMFYUI_SERVER_URL=http://127.0.0.1:8188

# 按能力分别指定地址。**只在多机部署时才需要**，单机请一律留空（继承上面）。
# 例如：视频跑在本地 20GB 卡上，图像跑在另一台机器上。
OM_BRIDGE_COMFYUI_VIDEO_SERVER_URL=
# COMFYUI_VIDEO_SERVER_URL=
OM_BRIDGE_COMFYUI_IMAGE_SERVER_URL=
# COMFYUI_IMAGE_SERVER_URL=
OM_BRIDGE_COMFYUI_MUSIC_SERVER_URL=
# COMFYUI_MUSIC_SERVER_URL=

# ⚠ 已废弃的别名，优先级最低，请不要再新增。
# 保留它只是为了兼容"历史上设过这个变量"的环境。
# 真正的原因是：OpenMontage **从不读取**这个名字，设了它不会有任何效果 ——
# 而它看起来又太像"正主"，是个容易浪费半小时的陷阱。
OM_BRIDGE_COMFYUI_BASE_URL=
# COMFYUI_BASE_URL=

# /system_stats 等轻量请求的超时（秒）。旧名: COMFYUI_CONNECT_TIMEOUT
OM_BRIDGE_COMFYUI_CONNECT_TIMEOUT=15
# COMFYUI_CONNECT_TIMEOUT=15

# 等待一次渲染完成的总超时（秒）。旧名: COMFYUI_READ_TIMEOUT
OM_BRIDGE_COMFYUI_READ_TIMEOUT=900
# COMFYUI_READ_TIMEOUT=900

# /history 轮询间隔（秒）。旧名: COMFYUI_POLL_INTERVAL
OM_BRIDGE_COMFYUI_POLL_INTERVAL=5
# COMFYUI_POLL_INTERVAL=5

# 拉取 /object_info 的超时（秒）。节点多的实例会明显偏慢（1200+ 个类是常态）。
OM_BRIDGE_COMFYUI_OBJECT_INFO_TIMEOUT=180

# 单次上传媒体的超时（秒）。
OM_BRIDGE_COMFYUI_UPLOAD_TIMEOUT=300

# 认证。**仅当 ComfyUI 位于鉴权代理之后**才需要；直连本机/局域网请留空。
# api_token 与 auth_user/auth_password 二选一。
OM_BRIDGE_COMFYUI_API_TOKEN=
# COMFYUI_API_TOKEN=
OM_BRIDGE_COMFYUI_AUTH_USER=
# COMFYUI_AUTH_USER=
OM_BRIDGE_COMFYUI_AUTH_PASSWORD=
# COMFYUI_AUTH_PASSWORD=


# =============================================================================
# 三、MiniMax H3 方案
# =============================================================================
# 这一节全是"部署事实"：这台机器上实际装着哪一套权重。
# 它们刻意不是命令行参数 —— 创作参数每次都可能不同，而权重是机器属性。
# 想临时换一套权重做对比，用 `--node-override <节点ID>.<输入名>=值`（逃生舱）。

# --- 输出规格 ---
# 宽度 / 高度必须是 32 的倍数。旧名: COMFYUI_MINIMAX_H3_WIDTH / _HEIGHT
OM_BRIDGE_SOLUTION_MINIMAX_H3_WIDTH=864
# COMFYUI_MINIMAX_H3_WIDTH=864
OM_BRIDGE_SOLUTION_MINIMAX_H3_HEIGHT=480
# COMFYUI_MINIMAX_H3_HEIGHT=480

# 帧数（24fps）。会对齐到 **17k+5** 栅格：5, 22, 39, 56, 73, 90, 107, 124, ...
# 124 帧 ≈ 5.2 秒；362 帧 ≈ 15 秒。未对齐时后端会自行吸附到最近合法值。
# 旧名: COMFYUI_MINIMAX_H3_LENGTH
OM_BRIDGE_SOLUTION_MINIMAX_H3_LENGTH=124
# COMFYUI_MINIMAX_H3_LENGTH=124

OM_BRIDGE_SOLUTION_MINIMAX_H3_FPS=24
# COMFYUI_MINIMAX_H3_FPS=24

# 采样步数。0 = 按模式自动（ref2v 用 4，其余用 8）。
#
# ⚠ 步数必须与所选 LoRA **配对**，否则不会报错、只会让画质悄悄变差：
#     turbo 开 + fl2va 权重 -> 8 步
#     turbo 开 + ref2va 权重 -> 4 步
#     不加 LoRA            -> 20 步
# 这种"静默降级"是最难发现的一类问题，因此方案层会对不一致发告警。
# 旧名: COMFYUI_MINIMAX_H3_STEPS
OM_BRIDGE_SOLUTION_MINIMAX_H3_STEPS=0
# COMFYUI_MINIMAX_H3_STEPS=0

# --- 扩散模型 ---
# ⚠ 两套权重**不可互换**：
#   fl2va 系列（下面这个）-> 用于 t2v / i2v / flf2v
#   ref2va 系列（再下面）-> 用于 ref2v
# 混用不会报错，只会得到"能跑但结果不对"的输出。
# 旧名: COMFYUI_MINIMAX_H3_UNET
OM_BRIDGE_SOLUTION_MINIMAX_H3_UNET=minimax_h3_fl2va_pruned_int8_convrot.safetensors
# COMFYUI_MINIMAX_H3_UNET=minimax_h3_fl2va_pruned_int8_convrot.safetensors

# 旧名: COMFYUI_MINIMAX_H3_REF2V_UNET
OM_BRIDGE_SOLUTION_MINIMAX_H3_REF2V_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors
# COMFYUI_MINIMAX_H3_REF2V_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors

# --- 文本编码器与 VAE（四种形态共用）---
# 旧名: COMFYUI_MINIMAX_H3_CLIP
OM_BRIDGE_SOLUTION_MINIMAX_H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
# COMFYUI_MINIMAX_H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors

# 旧名: COMFYUI_MINIMAX_H3_VIDEO_VAE
OM_BRIDGE_SOLUTION_MINIMAX_H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
# COMFYUI_MINIMAX_H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors

# H3 是**音视频联合生成**，缺音频 VAE 就没有音轨（画面正常，静音输出）。
# 旧名: COMFYUI_MINIMAX_H3_AUDIO_VAE
OM_BRIDGE_SOLUTION_MINIMAX_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
# COMFYUI_MINIMAX_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors

# --- Turbo LoRA ---
# 旧名: COMFYUI_MINIMAX_H3_TURBO_LORA
OM_BRIDGE_SOLUTION_MINIMAX_H3_TURBO_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
# COMFYUI_MINIMAX_H3_TURBO_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors

# 旧名: COMFYUI_MINIMAX_H3_REF2V_TURBO_LORA
OM_BRIDGE_SOLUTION_MINIMAX_H3_REF2V_TURBO_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors
# COMFYUI_MINIMAX_H3_REF2V_TURBO_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors

# --- ref2v 专项 ---
# 参考图缩放模式：
#   match -> 缩到生成分辨率。快，且是绝大多数场景的正确选择。
#   max   -> 保留 2048px 短边。身份更保真，但参考 token 会贯穿**每一步采样**，
#            慢数倍（ref2v 只有 4 步，所以这个代价是实打实的）。
# 旧名: COMFYUI_MINIMAX_H3_REF2V_IMAGE_SIZE
OM_BRIDGE_SOLUTION_MINIMAX_H3_REF2V_IMAGE_SIZE=match
# COMFYUI_MINIMAX_H3_REF2V_IMAGE_SIZE=match

# 默认参考图文件名（是 ComfyUI 主机 input/ 目录里**已有的名字**，不是路径）。
# 只在 ref2v 未显式给参考图时生效；调用方显式传的永远优先。
# ⚠ 顺序即语义：第 1 个对应提示词里的 <Picture 1>，第 2 个对应 <Picture 2>……
# 逗号分隔。最多 9 张。
# 旧名: COMFYUI_MINIMAX_H3_REF2V_IMAGES
OM_BRIDGE_SOLUTION_MINIMAX_H3_REF2V_IMAGES=
# COMFYUI_MINIMAX_H3_REF2V_IMAGES=

# --- 与外部框架的接口 ---
# 用于向外部框架（如 OpenMontage）声明「本机 H3 就绪」的扩散权重要求。
# 由集成层的 publish 脚本读取并写出 COMFYUI_H3_LOCAL_MODELS，供外部框架做前置检查。
# ⚠ 旧名就是 COMFYUI_H3_LOCAL_MODELS —— 这个名字是 OpenMontage 实际读取的，
#    所以它同时是"规范名"和"对外的兼容名"。
OM_BRIDGE_SOLUTION_MINIMAX_H3_PREFLIGHT_MODELS=minimax_h3_fl2va_pruned_int8_convrot.safetensors,minimax_h3_ref2va_pruned_int8_convrot.safetensors
# COMFYUI_H3_LOCAL_MODELS=minimax_h3_fl2va_pruned_int8_convrot.safetensors,minimax_h3_ref2va_pruned_int8_convrot.safetensors

# 物化后的计算图落盘目录。留空则用 <工作区>/var/graphs。
#
# 为什么需要它：有些外部框架只接受「工作流文件路径 + 输出节点 ID」，
# 拿不到内存里的图。OM-Bridge 的做法是**按需现场物化**：
#     om-bridge graph --solution minimax_h3 --prompt "..." -o <这个目录>/h3_t2v_api.json
# 于是不会再出现"预存的图与代码脱节"。
#
# ⚠ 历史说明：旧配置里的 COMFYUI_MINIMAX_H3_WORKFLOW_PATH / _OUTPUT_NODE /
#    _REF2V_WORKFLOW_PATH / _REF2V_OUTPUT_NODE 四个变量**已不再读取** ——
#    它们存在的唯一理由就是上面这件事，现在由本目录 + 现场物化取代。
OM_BRIDGE_SOLUTION_MINIMAX_H3_GRAPH_DIR=
