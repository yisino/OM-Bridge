# =============================================================================
# 拓扑档：同局域网直连
# =============================================================================
#
# 适用：OM-Bridge 与 ComfyUI 在同一个 /24 里，且 ComfyUI 监听 0.0.0.0。
#
# 用法：
#     OMB_ENV_FILE=config/profiles/same-lan.env om-bridge doctor
#
# ⚠ 直连的前提是"能连到"。若 ComfyUI 主机开了防火墙，或两台机器在不同网段，
#   请改用 through-tunnel.env —— 隧道方案对网络拓扑的要求低得多，
#   而且不需要为了认证去加一个代理组件。
#
# 未列出的配置项一律取内置默认值。
# =============================================================================

# 改成 ComfyUI 所在主机的实际地址。
OMB_COMFY_SERVER_URL=http://192.168.3.3:8188

# 工作区：产物与物化图的落盘根目录。
OMB_WORKSPACE=/home/vincent/MY_WS

# 产物默认落在 <工作区>/var/output。
OMB_OUTPUT_DIR=

# 局域网延迟低，探测超时用默认值即可（15s），此处显式写出以示可调。
OMB_COMFY_CONNECT_TIMEOUT=15
