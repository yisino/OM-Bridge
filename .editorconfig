# 统一编辑器行为，避免不同人提交出不同的空白字符/换行符。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 110

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2
